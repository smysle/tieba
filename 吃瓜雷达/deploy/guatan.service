[Unit]
Description=Guatan Radar - Tieba gossip monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/guatan
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Shanghai
ExecStart=/usr/bin/python3 /opt/guatan/app.py --host 0.0.0.0 --port 8788
Restart=on-failure
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
